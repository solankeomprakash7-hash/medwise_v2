# Names of the settings MedWise will need. NO VALUES here, ever.
# Real values are typed into the Vercel / Supabase settings screens, never committed to GitHub.

# Supabase (added in the database step)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (added in the AI step; server only, never NEXT_PUBLIC_)
ANTHROPIC_API_KEY=

# Google Gemini (owner decision 2026-10-30; server only, never NEXT_PUBLIC_). Used instead of Claude when set.
GEMINI_API_KEY=
# Optional: pin an exact Gemini model (default gemini-pro-latest)
GEMINI_MODEL=

# OpenRouter (owner decision 2026-11-04; server only). Used first when set.
OPENROUTER_API_KEY=
# Optional: pin a model, e.g. one chosen on openrouter.ai/models (default openrouter/auto)
OPENROUTER_MODEL=
